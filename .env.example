# Copy to .env.local and fill in your database host/port/name.
# The database username and password are entered at login, never stored here.
DATABASE_HOST=db.example.com
DATABASE_PORT=5432
DATABASE_NAME=restaurant_dashboard

# Set to "disable" only if your provider does not require SSL (most do).
# DATABASE_SSL=disable

# Secret used to encrypt the login session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
